#!/bin/sh
# Rejects the commit messages this repository accumulated for months: `-`, `=`,
# and GitHub's web-editor default `Update page.tsx`. Enable it once per clone:
#
#   git config core.hooksPath .githooks
#
# Merge, revert, fixup and squash commits keep their generated messages.

message_file="$1"
subject=$(sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$message_file" | head -n 1)

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *|amend!\ *)
    exit 0
    ;;
esac

fail() {
  echo "commit-msg: $1" >&2
  echo >&2
  echo "  Write what changed and why, e.g." >&2
  echo "    frontend: proxy /api to the backend instead of duplicating routes" >&2
  echo >&2
  echo "  Bypass once with --no-verify if you really mean it." >&2
  exit 1
}

if [ -z "$subject" ]; then
  fail "the message is empty."
fi

# `-`, `=`, `.`, `...` and friends. Matching punctuation rather than stripping
# non-letters keeps this correct for non-ASCII subjects under any locale.
if printf '%s' "$subject" | grep -Eq '^[[:punct:][:space:]]+$'; then
  fail "\"$subject\" has no words in it."
fi

if [ "${#subject}" -lt 10 ]; then
  fail "\"$subject\" is too short to say anything (min 10 characters)."
fi

# GitHub's web editor pre-fills this; it repeats the diff instead of explaining it.
if printf '%s' "$subject" | grep -Eq '^(Update|Create|Delete|Add|Rename) [^ ]+\.[A-Za-z0-9]+$'; then
  fail "\"$subject\" is the web editor's default — say why the file changed."
fi
