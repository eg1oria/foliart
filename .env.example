DATABASE_URL=file:/app/data/prod.db

SITE_URL=https://foliart.me
NEXT_PUBLIC_SITE_URL=https://foliart.me
NEXT_PUBLIC_API_URL=/api
FRONTEND_URL=https://foliart.me,https://www.foliart.me

# Сколько миллисекунд Next держит простаивающее соединение. Должно оставаться
# больше, чем keepalive_timeout апстрима в nginx.system.conf (60s), иначе nginx
# возьмёт из пула сокет, который Node уже закрыл, и отдаст случайный 502.
KEEP_ALIVE_TIMEOUT=70000

# Логин и пароль первого супер-админа. Читаются только при первом запуске, пока
# в базе нет ни одного администратора: дальше учётные записи живут в базе, а
# пароль меняется в самой админке (раздел «Мой профиль»).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_API_SECRET=

CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
